{
  "name": "area-membros",
  "version": "1.0.0",
  "description": "Área de membros com ofertas contextuais (back-end de LTV) da Fábrica de Panetones Caseiros",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "simulate": "node --disable-warning=ExperimentalWarning scripts/simulate.js",
    "lint": "tsc --noEmit -p web",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "demo": "DEMO=1 DATA_DIR=./data-demo node --disable-warning=ExperimentalWarning server/index.js",
    "build:static": "VITE_STATIC=1 vite build --config web/vite.config.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "lucide-react": "^1.55.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
