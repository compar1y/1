# Endereço público do app (usado nos links dos e-mails). Em produção: https://membros.seudominio.com
PUBLIC_URL=http://localhost:3100
PORT=3100

# Senha do painel /admin (sem ela, uma senha é gerada e aparece no terminal)
ADMIN_PASSWORD=

# Token secreto do webhook (sem ele, é gerado e aparece no terminal e no painel)
WEBHOOK_TOKEN=

# E-mail (https://resend.com). Sem isso, os links de acesso só aparecem no terminal.
RESEND_API_KEY=
EMAIL_FROM=Projetos com Madeira <acesso@seudominio.com>

# Opcional: repassa cada webhook de venda para o Retina (assim você cadastra uma URL só na Wiapy)
# Ex.: https://seu-retina.up.railway.app/webhook/demo/TOKEN_DO_RETINA
RETINA_WEBHOOK_URL=

# Onde ficam o banco e os PDFs (no Docker: /data e /data/content)
# DATA_DIR=./data
# CONTENT_DIR=./content
