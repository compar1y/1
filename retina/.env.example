# Porta do painel + coleta
PORT=3000
# Senha do painel (se vazio, uma senha aleatória é gerada e mostrada no terminal na 1ª execução)
RETINA_PASSWORD=
# Pasta do banco SQLite
RETINA_DATA_DIR=./data
# Fuso usado nos gráficos por dia/hora
RETINA_TZ=America/Sao_Paulo
# Dias de histórico mantidos
RETINA_RETENTION_DAYS=180
# Porta do servidor da página de demonstração (0 desliga)
DEMO_PORT=4000
